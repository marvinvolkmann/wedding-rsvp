# Postgres (used by docker compose)
POSTGRES_USER=wedding
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wedding
POSTGRES_PORT=5432

# Used by `npm run dev` and the scripts on your machine.
# Inside docker compose the app builds its own URL from the values above.
DATABASE_URL=postgres://wedding:change-me@localhost:5432/wedding

# After this moment RSVPs can no longer be submitted or changed.
RSVP_DEADLINE=2027-05-01T23:59:59+02:00

# Password for /admin
ADMIN_PASSWORD=change-me-too

APP_PORT=3000
